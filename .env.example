# SHIOL+ v9 — Variables de entorno
# Copia este archivo a .env y completa los valores
# NUNCA subas .env a git (ya está en .gitignore)

# ── Cloudflare ────────────────────────────────────────────────
# Tu Account ID: Cloudflare Dashboard → lado derecho de cualquier página
CLOUDFLARE_ACCOUNT_ID=tu_account_id_aqui

# API Token con permiso D1:edit
# Crear en: https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit Cloudflare Workers" o permiso específico D1
CLOUDFLARE_API_TOKEN=tu_api_token_aqui

# D1 database ID (ya configurado en wrangler.toml también)
D1_DATABASE_ID=ad168e4c-e90c-4642-8b29-6c8d0bfc6157
